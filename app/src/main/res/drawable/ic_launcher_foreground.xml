<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Security Shield (Outer Glow & Gradient Fill) -->
    <path
        android:pathData="M54,23 L79,33 C79,58 68,75 54,84 C40,75 29,58 29,33 Z"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="29"
                android:startY="23"
                android:endX="79"
                android:endY="84"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#00E676" android:offset="1.0" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="23"
                android:endX="54"
                android:endY="84"
                android:type="linear">
                <item android:color="#3800E5FF" android:offset="0.0" />
                <item android:color="#1A00E676" android:offset="0.7" />
                <item android:color="#0A0B101D" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Shield Accent Rim -->
    <path
        android:pathData="M54,27 L74,35 C74,55 65,69 54,77 C43,69 34,55 34,35 Z"
        android:strokeWidth="1.0"
        android:strokeColor="#3300E5FF" />

    <!-- Smartphone Body (Rounded Frame) -->
    <path
        android:pathData="M46,35 C43.8,35 42,36.8 42,39 L42,68 C42,70.2 43.8,72 46,72 L62,72 C64.2,72 66,70.2 66,68 L66,39 C66,36.8 64.2,35 62,35 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="42"
                android:startY="35"
                android:endX="66"
                android:endY="72"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#D6E4EE" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Smartphone Inner Display (Dark Glass Screen) -->
    <path
        android:pathData="M44.5,38.5 L63.5,38.5 L63.5,65 L44.5,65 Z"
        android:fillColor="#0E1724" />

    <!-- Speaker / Camera Notch -->
    <path
        android:pathData="M51,36.5 L57,36.5"
        android:strokeWidth="1.2"
        android:strokeColor="#78909C"
        android:strokeLineCap="round" />

    <!-- IMEI Scan Laser Bar across Display -->
    <path
        android:pathData="M45,51 L63,51"
        android:strokeWidth="2.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="45"
                android:startY="51"
                android:endX="63"
                android:endY="51"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#FFFFFF" android:offset="0.5" />
                <item android:color="#00E5FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Holographic Barcode Waves (above laser) -->
    <path
        android:pathData="M47,42 L61,42 M47,45 L58,45 M47,48 L59,48"
        android:strokeWidth="1.4"
        android:strokeColor="#00E5FF"
        android:strokeLineCap="round" />

    <!-- Biometric Fingerprint / Keyhole Anchor (below laser) -->
    <path
        android:pathData="M54,55 C52.3,55 51,56.3 51,58 C51,59.2 51.7,60.2 52.8,60.7 L52.2,63 L55.8,63 L55.2,60.7 C56.3,60.2 57,59.2 57,58 C57,56.3 55.7,55 54,55 Z"
        android:fillColor="#00E676" />

    <!-- Smartphone Home Indicator Bar at Bottom -->
    <path
        android:pathData="M52,69 L56,69"
        android:strokeWidth="1.5"
        android:strokeColor="#455A64"
        android:strokeLineCap="round" />

    <!-- Verified Emerald Badge (Bottom-Right of Shield) -->
    <path
        android:pathData="M65,59 C61.7,59 59,61.7 59,65 C59,68.3 61.7,71 65,71 C68.3,71 71,68.3 71,65 C71,61.7 68.3,59 65,59 Z"
        android:fillColor="#00E676" />
    <path
        android:pathData="M62.5,65 L64.3,66.8 L67.8,63.2"
        android:strokeWidth="1.8"
        android:strokeColor="#0A0E17"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
